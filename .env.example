# Copy to .env and fill in. NEVER commit a real .env (it is git-ignored).
# Docker Compose also reads this file for the ${VAR} values in docker-compose.yml.

ENV=local                      # local | sandbox | demo | production
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://slothpay:slothpay@localhost:5432/slothpay
REDIS_URL=redis://localhost:6379/0

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# PayPal SANDBOX credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-webhook-id

SENTRY_DSN=

# AI model endpoint (Gemma 4 through your chosen host). Leave empty to use fallbacks.
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=

# Controlled failures for testing. Sandbox/local only.
CHAOS_ENABLED=false
ADMIN_API_KEY=change-me-to-a-long-random-string-at-least-32-chars
PASSPORT_SIGNING_SECRET=change-me-to-a-long-random-string-at-least-32-chars

CONDITION_MAX_HOURS=48
ALLOWED_CURRENCIES=USD,EUR,GBP,INR

# Task 16: sessions, rate limits and request size
# POST /api/demo-login issues a signed, HttpOnly session cookie (signed with
# PASSPORT_SIGNING_SECRET). Outside ENV=local the X-Owner-Id header is ignored.
SESSION_TTL_HOURS=12
DEMO_USERS=alice,bob,carol
RATE_LIMIT_PAYMENTS_PER_MINUTE=30
RATE_LIMIT_WEBHOOK_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=20
MAX_REQUEST_BYTES=65536
# In demo and production the app refuses to start unless PAYPAL_BASE_URL is the PayPal sandbox,
# ADMIN_API_KEY and PASSPORT_SIGNING_SECRET are real random values of 32+ characters, and
# CHAOS_ENABLED is false. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Task 17: hosting without background workers
# true = run the recovery and webhook loops inside the API (what the hosted demo does, because
# Render's free plan has no workers). Leave false when Docker Compose runs them as containers.
RUN_BACKGROUND_WORKERS=false
BACKGROUND_WORKER_INTERVAL_SECONDS=5
