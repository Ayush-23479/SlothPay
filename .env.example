# Copy to .env and fill in. NEVER commit a real .env (it is git-ignored).
# Docker Compose also reads this file for the ${VAR} values in docker-compose.yml.

ENV=local                      # local | sandbox | demo | production
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://slothpay:slothpay@localhost:5432/slothpay
REDIS_URL=redis://localhost:6379/0

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# PayPal SANDBOX credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-webhook-id

SENTRY_DSN=

# AI model endpoint (Gemma 4 through your chosen host). Leave empty to use fallbacks.
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=

# Controlled failures for testing. Sandbox/local only.
CHAOS_ENABLED=false
ADMIN_API_KEY=change-me-to-a-long-random-string-at-least-32-chars
PASSPORT_SIGNING_SECRET=change-me-to-a-long-random-string-at-least-32-chars

CONDITION_MAX_HOURS=48
ALLOWED_CURRENCIES=USD,EUR,GBP,INR
